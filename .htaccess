<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive files
    <FilesMatch "(^\.env$|^\.env\.|^\.git|^composer\.(json|lock)$|^package(-lock)?\.json$|\.(xml|md|log|ini|sh|sql)$)">
        Require all denied
    </FilesMatch>

    # Forward all traffic to the public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
